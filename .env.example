APP_ADDR=:8080
APP_ENV=local

AGENT_ID=voice-agent

# LLM_PROVIDER=none keeps the ADK runner on the local echo fallback.
# Use LLM_PROVIDER=gemini or LLM_PROVIDER=doubao to enable ADK llmagent + runner.Run streaming events.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
DOUBAO_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_LLM_API_KEY=
DOUBAO_LLM_MODEL=
DOUBAO_LLM_TIMEOUT_SECONDS=60
AGENT_INSTRUCTION="You are a realtime voice assistant. Keep answers natural, concise, and suitable for TTS."

# ADK session events are stored in PostgreSQL through ADK v2 session/database.
# Example: host=127.0.0.1 user=ropet password=ropet_pass dbname=ropet_agent port=5432 sslmode=disable
ADK_SESSION_POSTGRES_DSN=
ADK_SESSION_AUTO_MIGRATE=true

# self_hosted uses X-API-Key and /memories + /search.
# cloud_v3 uses Authorization: Token <key> and /v3/memories/add/ + /v3/memories/search/.
MEM0_MODE=self_hosted
MEM0_BASE_URL=http://localhost:8888
MEM0_API_KEY=
MEM0_TOP_K=8
MEM0_TIMEOUT_SECONDS=10

# VAD_PROVIDER=passthrough sends the full microphone stream, including silence, to the ASR provider.
# Use VAD_PROVIDER=silero only for the legacy local-VAD ASR path.
VAD_PROVIDER=passthrough
SILERO_VAD_MODEL_PATH=models/silero-vad/silero_vad.onnx
VAD_SAMPLE_RATE=16000
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=200
VAD_MIN_SPEECH_MS=250
VAD_SPEECH_PAD_MS=30
VAD_PRE_ROLL_MS=800
VAD_AUDIO_BUFFER_SECONDS=5
VAD_MAX_SPEECH_MS=15000

# Fun-ASR-Nano is the selected private real-time ASR provider. Start it on the same host or a private network.
ASR_PROVIDER=funasr
FUNASR_URL=ws://127.0.0.1:10095
FUNASR_SAMPLE_RATE=16000
FUNASR_TIMEOUT_SECONDS=30

# Optional Alibaba NLS fallback configuration. Its temporary token must be refreshed outside this process before it expires.
ALIYUN_NLS_URL=wss://nls-gateway.cn-shanghai.aliyuncs.com/ws/v1
ALIYUN_NLS_TOKEN=
ALIYUN_NLS_APP_KEY=
ALIYUN_NLS_SAMPLE_RATE=16000
ALIYUN_NLS_ENABLE_INTERMEDIATE=true
ALIYUN_NLS_ENABLE_PUNCTUATION=true
ALIYUN_NLS_ENABLE_ITN=true
ALIYUN_NLS_ENABLE_SEMANTIC_SENTENCE_DETECTION=true
ALIYUN_NLS_MAX_SENTENCE_SILENCE_MS=800
ALIYUN_NLS_TIMEOUT_SECONDS=30

# Legacy Doubao ASR configuration. Keep credentials out of this file.
DOUBAO_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
DOUBAO_ASR_APP_KEY=
DOUBAO_ASR_ACCESS_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_ASR_MODEL_NAME=bigmodel
DOUBAO_ASR_LANGUAGE=zh-CN
DOUBAO_ASR_SAMPLE_RATE=16000
DOUBAO_ASR_ENABLE_PUNC=true
DOUBAO_ASR_COMPRESS_AUDIO=true
DOUBAO_ASR_TIMEOUT_SECONDS=30
# Doubao bidirectional streaming TTS.
TTS_PROVIDER=none
DOUBAO_TTS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_TOKEN=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=saturn_zh_female_cancan_tob
DOUBAO_TTS_SAMPLE_RATE=16000
