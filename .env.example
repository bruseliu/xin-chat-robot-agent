APP_ADDR=:8080
APP_ENV=local

AGENT_ID=voice-agent

# self_hosted uses X-API-Key and /memories + /search.
# cloud_v3 uses Authorization: Token <key> and /v3/memories/add/ + /v3/memories/search/.
MEM0_MODE=self_hosted
MEM0_BASE_URL=http://localhost:8888
MEM0_API_KEY=
MEM0_TOP_K=8
MEM0_TIMEOUT_SECONDS=10
