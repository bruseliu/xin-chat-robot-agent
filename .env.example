APP_ADDR=:8080
APP_ENV=local

AGENT_ID=voice-agent

# ADK session events are stored in PostgreSQL through ADK v2 session/database.
# Example: host=127.0.0.1 user=ropet password=ropet_pass dbname=ropet_agent port=5432 sslmode=disable
ADK_SESSION_POSTGRES_DSN=
ADK_SESSION_AUTO_MIGRATE=true

# self_hosted uses X-API-Key and /memories + /search.
# cloud_v3 uses Authorization: Token <key> and /v3/memories/add/ + /v3/memories/search/.
MEM0_MODE=self_hosted
MEM0_BASE_URL=http://localhost:8888
MEM0_API_KEY=
MEM0_TOP_K=8
MEM0_TIMEOUT_SECONDS=10
