APP_ADDR=:8080
APP_ENV=local

AGENT_ID=voice-agent

# ADK session events are stored in PostgreSQL through ADK v2 session/database.
# Example: host=127.0.0.1 user=ropet password=ropet_pass dbname=ropet_agent port=5432 sslmode=disable
ADK_SESSION_POSTGRES_DSN=
ADK_SESSION_AUTO_MIGRATE=true

# self_hosted uses X-API-Key and /memories + /search.
# cloud_v3 uses Authorization: Token <key> and /v3/memories/add/ + /v3/memories/search/.
MEM0_MODE=self_hosted
MEM0_BASE_URL=http://localhost:8888
MEM0_API_KEY=
MEM0_TOP_K=8
MEM0_TIMEOUT_SECONDS=10

# VAD_PROVIDER=none keeps VAD disabled for text-only local smoke tests.
# Use VAD_PROVIDER=silero with the repo-local Silero VAD v5 ONNX model in the default cgo build.
VAD_PROVIDER=silero
SILERO_VAD_MODEL_PATH=models/silero-vad/silero_vad.onnx
VAD_SAMPLE_RATE=16000
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=200
VAD_MIN_SPEECH_MS=250
VAD_SPEECH_PAD_MS=30
VAD_PRE_ROLL_MS=800
VAD_AUDIO_BUFFER_SECONDS=5
VAD_MAX_SPEECH_MS=15000

# ASR_PROVIDER=doubao enables the connection-level Doubao/Volcengine ASR stream.
ASR_PROVIDER=funasr
FUNASR_URL=ws://127.0.0.1:10095
FUNASR_SAMPLE_RATE=16000
FUNASR_TIMEOUT_SECONDS=30
DOUBAO_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
DOUBAO_ASR_APP_KEY=9682392626
DOUBAO_ASR_ACCESS_KEY=B1BNXls_E63hqNzAcYm3n6z5G2E0eQkE
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_ASR_MODEL_NAME=bigmodel
DOUBAO_ASR_LANGUAGE=zh-CN
DOUBAO_ASR_SAMPLE_RATE=16000
DOUBAO_ASR_ENABLE_PUNC=true
DOUBAO_ASR_COMPRESS_AUDIO=true
DOUBAO_ASR_TIMEOUT_SECONDS=30

TTS_PROVIDER=doubao
DOUBAO_TTS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
DOUBAO_TTS_APP_ID=9682392626
DOUBAO_TTS_ACCESS_TOKEN=B1BNXls_E63hqNzAcYm3n6z5G2E0eQkE
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=saturn_zh_female_cancan_tob
DOUBAO_TTS_SAMPLE_RATE=16000

LLM_PROVIDER=doubao
DOUBAO_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_LLM_API_KEY=0ca0e7da-0ac3-4eb6-988d-bbc7668e0212
DOUBAO_LLM_MODEL=doubao-seed-2-0-mini-260428
